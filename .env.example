DISCORD_TOKEN=replace_with_your_bot_token
DATABASE_PATH=/app/data/giveaway.sqlite3
# Enable both in Developer Portal and here for AI, translation, word/message logs.
TICKET_AI_MESSAGE_CONTENT=0
# Optional OpenAI features (leave blank to keep them unconfigured)
OPENAI_API_KEY=
OPENAI_TICKET_MODEL=gpt-4.1-mini
# Optional Minecraft verification
MC_VERIFY_DOMAIN=
MC_VERIFY_PORT=25565
VERIFY_SHARED_SECRET=
BEDROCK_VERIFY_HOST=
BEDROCK_PUBLIC_IP=
BEDROCK_VERIFY_PORT=19132
# Optional: your peer bot ID and private community template source guild.
# PEER_BOT_ID=
# COMMUNITY_SOURCE_GUILD_ID=
